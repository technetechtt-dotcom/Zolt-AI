{
  "name": "zolt-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone advisory industrial intelligence platform",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:gateway": "tsx apps/connector-gateway/src/server.ts",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "dev:console": "tsx apps/console/src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "audit": "pnpm audit --prod",
    "db:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "smoke:e2e": "tsx scripts/smoke-e2e.ts",
    "test:db-isolation": "tsx scripts/verify-tenant-constraints.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:soak": "tsx scripts/load-test.ts",
    "test:restore": "powershell -ExecutionPolicy Bypass -File scripts/verify-backup-restore.ps1",
    "test:chaos": "powershell -ExecutionPolicy Bypass -File scripts/chaos-test.ps1",
    "test:hil": "powershell -ExecutionPolicy Bypass -File scripts/hil-gridflex-rs485.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@zolt/auth": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "@fastify/ajv-compiler>fast-uri": "3.1.5",
      "fast-json-stringify>fast-uri": "4.1.2"
    }
  }
}
