generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstallationStatus {
  ACTIVE
  INACTIVE
  COMMISSIONING
  DECOMMISSIONED
  ARCHIVED
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED
  UNKNOWN
  ARCHIVED
}

enum RecommendationSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatusEnum {
  PROPOSED
  ACKNOWLEDGED
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
  RESOLVED
}

enum AuditActorType {
  USER
  API
  SYSTEM
  DEVICE
  SERVICE_ACCOUNT
}

enum WebhookStatus {
  ACTIVE
  DISABLED
  FAILING
}

enum IdentityKind {
  USER
  SERVICE_ACCOUNT
  DEVICE
  API_INTEGRATION
}

enum CredentialStatus {
  PENDING_APPROVAL
  ACTIVE
  REVOKED
  EXPIRED
  ROTATED
}

enum CredentialKind {
  API_INTEGRATION
  SERVICE_ACCOUNT
  DEVICE
}

enum AccountTokenPurpose {
  INVITATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_UNLOCK
}

model Tenant {
  id                    String                @id @default(cuid())
  name                  String
  plan                  String                @default("pilot")
  region                String                @default("af-south-1")
  billingEmail          String?
  slaAvailabilityTarget Float                 @default(0.995)
  telemetryRetentionDays Int                  @default(90)
  recommendationRetentionDays Int             @default(365)
  auditRetentionDays      Int                   @default(2555)
  ingestQuotaPerMinute  Int                   @default(600)
  webhookQuota          Int                   @default(20)
  createdAt             DateTime              @default(now())
  archivedAt            DateTime?
  products              Product[]
  installations         ProductInstallation[]
  recommendations       Recommendation[]
  memberships           TenantMembership[]
  credentials           ApiCredential[]
  webhooks              WebhookEndpoint[]
  auditEvents           AuditEvent[]
  usageMeters           UsageMeter[]
  roles                 Role[]
  invoices              Invoice[]
  slaIncidents          SlaIncident[]
  models                ModelRegistry[]
}

model Product {
  id            String                @id @default(cuid())
  tenantId      String
  key           String
  name          String
  category      String
  externalKey   String?
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  installations ProductInstallation[]
  credentials   ApiCredential[]

  @@unique([id, tenantId])
  @@unique([tenantId, key])
  @@unique([tenantId, externalKey])
}

model ProductInstallation {
  id              String              @id @default(cuid())
  tenantId        String
  productId       String
  externalKey     String
  name            String
  status          InstallationStatus  @default(ACTIVE)
  topology        Json?
  capacityKw      Float?
  archivedAt      DateTime?
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  product         Product             @relation(fields: [productId, tenantId], references: [id, tenantId])
  devices         Device[]
  assets          Asset[]
  telemetry       TelemetryMessage[]
  recommendations Recommendation[]
  credentials     ApiCredential[]
  accessScopes    InstallationAccess[]
  calibrations    SensorCalibration[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, productId])
  @@unique([tenantId, productId, externalKey])
  @@index([tenantId, productId])
}

model Device {
  id             String              @id @default(cuid())
  tenantId       String
  installationId String
  externalRef    String
  name           String
  type           String
  status         DeviceStatus        @default(UNKNOWN)
  vendor         String?
  model          String?
  firmwareVersion String?
  lastSeen       DateTime?
  lastSequence   Int?
  archivedAt     DateTime?
  installation   ProductInstallation @relation(fields: [installationId, tenantId], references: [id, tenantId])

  @@unique([tenantId, installationId, externalRef])
}

model Asset {
  id                String              @id @default(cuid())
  tenantId          String
  installationId    String
  externalRef       String
  name              String
  type              String
  operationalLimits Json?
  validationProfile Json?
  archivedAt        DateTime?
  installation      ProductInstallation @relation(fields: [installationId, tenantId], references: [id, tenantId])
  calibrations      SensorCalibration[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, installationId])
  @@unique([tenantId, installationId, externalRef])
}

model SensorCalibration {
  id              String              @id @default(cuid())
  tenantId        String
  installationId  String
  assetId         String
  measurementKey  String
  calibrationData Json
  calibratedAt    DateTime
  nextDueAt       DateTime?
  calibratedBy    String?
  certificateRef  String?
  createdAt       DateTime            @default(now())
  installation    ProductInstallation @relation(fields: [installationId, tenantId], references: [id, tenantId])
  asset           Asset               @relation(fields: [assetId, tenantId, installationId], references: [id, tenantId, installationId])

  @@index([tenantId, installationId, assetId, measurementKey, calibratedAt])
}

model TelemetryMessage {
  id                String              @id @default(cuid())
  tenantId          String
  productId         String
  installationId    String
  messageId         String
  deduplicationHash String
  correlationId     String?
  deviceId          String
  assetId           String?
  sequenceNumber    Int?
  sourceTimestamp   DateTime
  receivedTimestamp DateTime
  stale             Boolean             @default(false)
  delayed           Boolean             @default(false)
  outOfOrder        Boolean             @default(false)
  simulated         Boolean             @default(false)
  schemaVersion     String              @default("1.0")
  completenessScore Float?
  qualityScore       Float?
  clockQualityScore  Float?
  sourceTrustLevel   String?
  qualityIssues      Json?
  payload           Json
  archivedAt        DateTime?
  installation      ProductInstallation @relation(fields: [installationId, tenantId, productId], references: [id, tenantId, productId])

  @@unique([tenantId, installationId, messageId])
  @@unique([tenantId, installationId, deduplicationHash])
  @@index([tenantId, productId, deviceId, sourceTimestamp])
}

model Recommendation {
  id                  String                    @id @default(cuid())
  tenantId            String
  productId           String
  installationId      String
  capabilityPack      String
  skillId             String
  type                String
  title               String
  summary             String
  proposedAction      String
  rationale           String
  confidence          Float
  confidenceBreakdown Json
  severity            RecommendationSeverity
  priority            Int
  status              RecommendationStatusEnum  @default(PROPOSED)
  evidence            Json
  assumptions         Json
  uncertainties       Json
  dataQualityWarnings Json
  ruleVersion         String
  modelVersion        String?
  inputSnapshotId     String
  expectedEnergyKwh   Float?
  expectedRevenue     Float?
  expectedCarbonKg    Float?
  actionDeadline      DateTime?
  safetyClass         String                    @default("advisory")
  useful              Boolean?
  correct             Boolean?
  decisionActorId     String?
  decisionComment     String?
  supersededById      String?
  validFrom           DateTime
  expiresAt           DateTime
  archivedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenant              Tenant                    @relation(fields: [tenantId], references: [id])
  installation        ProductInstallation       @relation(fields: [installationId, tenantId, productId], references: [id, tenantId, productId])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, productId, installationId, priority])
  @@index([tenantId, skillId, status])
}

model AuditEvent {
  id            String         @id @default(cuid())
  tenantId      String
  eventType     String
  actorType     AuditActorType
  actorId       String?
  subjectType   String
  subjectId     String
  metadata      Json?
  correlationId String?
  createdAt     DateTime       @default(now())
  tenant        Tenant         @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

model User {
  id             String             @id @default(cuid())
  email          String             @unique
  name           String
  passwordHash   String?
  mfaSecret      String?
  mfaEnabled     Boolean            @default(false)
  emailVerifiedAt DateTime?
  passwordChangedAt DateTime?
  kind           IdentityKind       @default(USER)
  lockedUntil    DateTime?
  failedLogins   Int                @default(0)
  invitedAt      DateTime?
  acceptedAt     DateTime?
  lastLoginAt    DateTime?
  lastActiveAt   DateTime?
  deactivatedAt  DateTime?
  createdAt      DateTime           @default(now())
  archivedAt     DateTime?
  memberships    TenantMembership[]
  recoveryCodes  MfaRecoveryCode[]
  accountTokens  AccountToken[]
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  key         String
  name        String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([id, tenantId])
  @@unique([tenantId, key])
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model TenantMembership {
  id                 String               @id @default(cuid())
  tenantId           String
  userId             String
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  roles              MembershipRole[]
  installationAccess InstallationAccess[]
  sessions           Session[]
  credentials        ApiCredential[]

  @@unique([tenantId, userId])
}

model MembershipRole {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  roleId     String
  membership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId])
  role       Role             @relation(fields: [roleId, tenantId], references: [id, tenantId])

  @@unique([tenantId, userId, roleId])
  @@map("UserRole")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model InstallationAccess {
  id             String              @id @default(cuid())
  tenantId       String
  userId         String
  installationId String
  membership     TenantMembership    @relation(fields: [tenantId, userId], references: [tenantId, userId])
  installation   ProductInstallation @relation(fields: [installationId, tenantId], references: [id, tenantId])

  @@unique([tenantId, userId, installationId])
}

model Session {
  id          String           @id @default(cuid())
  userId      String
  tenantId    String
  tokenHash   String           @unique
  deviceName  String?
  userAgent   String?
  ipAddress   String?
  lastSeenAt  DateTime         @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  membership  TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId])

  @@index([tenantId, userId, revokedAt])
}

model MfaRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model AccountToken {
  id        String              @id @default(cuid())
  userId    String
  purpose   AccountTokenPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model ApiCredential {
  id                 String              @id @default(cuid())
  tenantId           String
  productId          String?
  installationId     String?
  userId             String?
  name               String
  keyPrefix          String
  keyHash            String
  signingSecretEnc   String
  permissions        Json
  kind               CredentialKind      @default(API_INTEGRATION)
  status             CredentialStatus    @default(ACTIVE)
  approvedAt         DateTime?
  approvedById       String?
  expiresAt          DateTime?
  revokedAt          DateTime?
  rotatedFromId      String?
  lastUsedAt         DateTime?
  createdAt          DateTime            @default(now())
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  product            Product?            @relation(fields: [productId, tenantId], references: [id, tenantId])
  installation       ProductInstallation? @relation(fields: [installationId, tenantId, productId], references: [id, tenantId, productId])
  membership         TenantMembership?    @relation(fields: [tenantId, userId], references: [tenantId, userId])

  @@index([tenantId, keyPrefix])
  @@index([tenantId, status])
}

model WebhookEndpoint {
  id              String            @id @default(cuid())
  tenantId        String
  url             String
  secretEnc       String
  events          Json
  status          WebhookStatus     @default(ACTIVE)
  failureCount    Int               @default(0)
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  createdAt       DateTime          @default(now())
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  deliveries      WebhookDelivery[]
}

model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  eventType      String
  idempotencyId  String
  payload        Json
  status         String
  attempts       Int             @default(0)
  lastError      String?
  createdAt      DateTime        @default(now())
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@unique([endpointId, idempotencyId])
  @@index([endpointId, createdAt])
}

model UsageMeter {
  id        String   @id @default(cuid())
  tenantId  String
  metric    String
  value     Float
  period    String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, metric, period])
}

model ModelRegistry {
  id            String   @id @default(cuid())
  tenantId      String?
  name          String
  version       String
  status        String   @default("candidate")
  metadata      Json?
  evaluation    Json?
  artifactUri   String?
  trainingDatasetVersion String?
  featureSetVersion String?
  trainingParameters Json?
  trainedAt     DateTime?
  owner         String?
  approvalOwner String?
  environment   String?
  rollbackVersion String?
  driftStatus   String             @default("unknown")
  explainability Json?
  intendedUse   String?
  limitations   Json?
  safetyThresholds Json?
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name, version])
}

model Invoice {
  id          String   @id @default(cuid())
  tenantId    String
  period      String
  amount      Float
  currency    String   @default("ZAR")
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, period])
}

model SlaIncident {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  severity    String
  startedAt   DateTime @default(now())
  resolvedAt  DateTime?
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}
