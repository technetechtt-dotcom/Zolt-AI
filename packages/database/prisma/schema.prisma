generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String                @id @default(cuid())
  name            String
  createdAt       DateTime              @default(now())
  products        Product[]
  installations   ProductInstallation[]
  recommendations Recommendation[]
}

model Product {
  id            String                @id @default(cuid())
  tenantId      String
  key           String
  name          String
  category      String
  externalKey   String?
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  installations ProductInstallation[]

  @@unique([tenantId, key])
  @@unique([tenantId, externalKey])
}

model ProductInstallation {
  id              String                @id @default(cuid())
  tenantId        String
  productId       String
  externalKey     String
  name            String
  status          String                @default("ACTIVE")
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  product         Product               @relation(fields: [productId], references: [id])
  devices         Device[]
  assets          Asset[]
  telemetry       TelemetryMessage[]
  recommendations Recommendation[]

  @@unique([tenantId, productId, externalKey])
  @@index([tenantId, productId])
}

model Device {
  id             String              @id @default(cuid())
  tenantId       String
  installationId String
  externalRef    String
  name           String
  type           String
  lastSeen       DateTime?
  installation   ProductInstallation @relation(fields: [installationId], references: [id])

  @@unique([tenantId, installationId, externalRef])
}

model Asset {
  id                String              @id @default(cuid())
  tenantId          String
  installationId    String
  externalRef       String
  name              String
  type              String
  operationalLimits Json?
  installation      ProductInstallation @relation(fields: [installationId], references: [id])

  @@unique([tenantId, installationId, externalRef])
}

model TelemetryMessage {
  id                String              @id @default(cuid())
  tenantId          String
  productId         String
  installationId    String
  messageId         String
  deduplicationHash String
  correlationId     String?
  deviceId          String
  assetId           String?
  sourceTimestamp   DateTime
  receivedTimestamp DateTime
  payload           Json
  installation      ProductInstallation @relation(fields: [installationId], references: [id])

  @@unique([tenantId, installationId, messageId])
  @@unique([tenantId, installationId, deduplicationHash])
  @@index([tenantId, productId, deviceId, sourceTimestamp])
}

model Recommendation {
  id                  String              @id @default(cuid())
  tenantId            String
  productId           String
  installationId      String
  capabilityPack      String
  skillId             String
  type                String
  title               String
  summary             String
  proposedAction      String
  rationale           String
  confidence          Float
  confidenceBreakdown Json
  severity            String
  priority            Int
  status              String              @default("PROPOSED")
  evidence            Json
  assumptions         Json
  uncertainties       Json
  dataQualityWarnings Json
  ruleVersion         String
  inputSnapshotId     String
  validFrom           DateTime
  expiresAt           DateTime
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  installation        ProductInstallation @relation(fields: [installationId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, productId, installationId, priority])
}

model AuditEvent {
  id            String   @id @default(cuid())
  tenantId      String
  eventType     String
  actorType     String
  actorId       String?
  subjectType   String
  subjectId     String
  metadata      Json?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
}
